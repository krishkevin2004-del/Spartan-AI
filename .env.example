# Copy this file to .env.local and fill in your key. Never commit .env.local.
ANTHROPIC_API_KEY=sk-ant-...

# ── Set these in Vercel for production (see README → Deploying) ──
# Redis (added automatically when you connect Upstash or Redis from the Vercel Marketplace):
# KV_REST_API_URL=...   and   KV_REST_API_TOKEN=...      (Upstash)
# Storage_REDIS_URL=redis://...                          (Redis)
# Hard cap on Claude spending per day, in dollars (default 0.50 ≈ $15/month):
# DAILY_BUDGET_USD=0.50
# Optional: a long random string used to anonymize IP addresses in the rate limiter:
# IP_HASH_SALT=...

# ── Dining skill (off until the menu source is authorized) ──
# DINING_ENABLED=1        turns the dining skill on
# INGEST_SECRET=...       long random string; the daily menu update must send it to /api/dining/ingest

# ── Events skill (UAB events feed; off until you switch it on) ──
# EVENTS_ENABLED=1        turns the events skill on
# CRON_SECRET=...         long random string (24+ characters). Vercel Cron sends it to /api/cron/events,
#                         which refreshes the events calendar once a day

# Optional: print token usage for each question
# LOG_USAGE=1
